APP_NAME="IDCard Pro"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Host ports (docker compose)
APP_PORT=8080
VITE_PORT=5173
FORWARD_DB_PORT=3307
MAILPIT_UI_PORT=8025

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=idcard_pro
DB_USERNAME=idcard
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_DOMAIN=
SANCTUM_STATEFUL_DOMAINS=localhost:8080,127.0.0.1:8080,localhost:5173

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

FILESYSTEM_DISK=local

# All mail is captured by Mailpit in development (http://localhost:8025)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="no-reply@idcard.local"
MAIL_FROM_NAME="${APP_NAME}"

# SMS driver: log | (future: twilio, bulksmsbd, ...)
SMS_DRIVER=log

# Server-side PDF (config/pdf.php): gotenberg = local Chromium container (no internet), or empty to switch off
PDF_DRIVER=gotenberg
GOTENBERG_URL=http://gotenberg:3000
PDF_APP_URL=http://web

# Biometric driver: simulator | upload | (future: secugen, zkteco, digitalpersona)
BIOMETRIC_DRIVER=simulator

VITE_APP_NAME="${APP_NAME}"

# Biometrics (config/biometrics.php): own encryption key, create with `php artisan app:biometric-key`
BIOMETRIC_KEY=
BIOMETRIC_PREVIOUS_KEYS=
# Made-up captures for testing: on unless APP_ENV=production; set false to hide it anywhere
# BIOMETRIC_SIMULATOR=
